# ─────────────────────────────────────────────────────────────────
# Compressor AI — Environment Variables
# Copy this file to .env.local for local development.
# Add each variable in: Netlify Dashboard → Site → Environment Variables
# ─────────────────────────────────────────────────────────────────

# PostgreSQL — free database from neon.tech
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host/compressorai?sslmode=require

# JWT secret — generate with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-minimum-32-chars

# Admin registration secret — used when creating the first admin account
# Set to any secret string, then pass it in the register request body
REGISTER_SECRET=replace-with-another-secret

# Anthropic — add your key when ready
# The platform works without this using fallback demo text
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-4-6

# Cloudflare R2 — for model file uploads (optional, not needed for demo)
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY=your-r2-access-key
R2_SECRET_KEY=your-r2-secret-key
R2_BUCKET=compressor-ai-models

# Your deployed Netlify URL (used for internal references)
NEXT_PUBLIC_API_BASE=https://your-site.netlify.app
