# ─────────────────────────────────────────────────────────────────
# Compressor AI — Next.js Backend Environment Variables
# ─────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# The app runs without an API key — Claude endpoints fall back to
# the canned demo text the frontend supplies.

# Anthropic API key (optional — enables real Claude AI responses)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Claude model to use for AI analysis and report generation
CLAUDE_MODEL=claude-sonnet-4-6

# SQLite database path (relative to project root)
# Default: ./compressor.db
# DB_PATH=./compressor.db

# Port (used by npm run dev / npm start)
# PORT=8000
